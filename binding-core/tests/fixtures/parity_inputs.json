{
  "_description": "Parity test inputs: every JACS language binding must accept these inputs and produce structurally identical outputs. Exact bytes differ (crypto nonce) but field names, types, and verifiability must match.",
  "sign_message_inputs": [
    {
      "name": "simple_message",
      "data": {"action": "test", "value": 42}
    },
    {
      "name": "nested_message",
      "data": {"user": {"name": "Alice", "role": "admin"}, "items": [1, 2, 3]}
    },
    {
      "name": "empty_object",
      "data": {}
    },
    {
      "name": "string_value",
      "data": "hello world"
    },
    {
      "name": "numeric_value",
      "data": 12345
    },
    {
      "name": "historical_rfc8785_decimal",
      "data": {"amount": 333333333.33333329}
    },
    {
      "name": "boolean_value",
      "data": true
    },
    {
      "name": "null_value",
      "data": null
    },
    {
      "name": "unicode_ascii_safe",
      "data": {"greeting": "hello", "code": "ABC-123"}
    }
  ],
  "sign_raw_bytes_inputs": [
    {
      "name": "hello_world",
      "data_base64": "aGVsbG8gd29ybGQ="
    },
    {
      "name": "binary_data",
      "data_base64": "AAECBA=="
    }
  ],
  "canonicalization_vectors": [
    {
      "name": "rfc8785_serialization_with_safe_integer",
      "data": {
        "numbers": [333333333.33333329, 1E12, 4.50, 2e-3, 0.000000000000000000000000001],
        "string": "\u20ac$\u000F\u000aA'B\"\\\\\"/",
        "literals": [null, true, false]
      },
      "expected": "{\"literals\":[null,true,false],\"numbers\":[333333333.3333333,1000000000000,4.5,0.002,1e-27],\"string\":\"€$\\u000f\\nA'B\\\"\\\\\\\\\\\"/\"}"
    },
    {
      "name": "rfc8785_property_sorting_sample",
      "data": {
        "\u20ac": "Euro Sign",
        "\r": "Carriage Return",
        "\ufb33": "Hebrew Letter Dalet With Dagesh",
        "1": "One",
        "\ud83d\ude00": "Emoji: Grinning Face",
        "\u0080": "Control",
        "\u00f6": "Latin Small Letter O With Diaeresis"
      },
      "expected": "{\"\\r\":\"Carriage Return\",\"1\":\"One\",\"\":\"Control\",\"ö\":\"Latin Small Letter O With Diaeresis\",\"€\":\"Euro Sign\",\"😀\":\"Emoji: Grinning Face\",\"דּ\":\"Hebrew Letter Dalet With Dagesh\"}"
    }
  ],
  "canonicalization_rejections": [
    {
      "name": "positive_integer_above_i_json_safe_range",
      "input": "{\"amount\":9007199254740992}",
      "message_pattern": "safe integer range"
    },
    {
      "name": "negative_integer_below_i_json_safe_range",
      "input": "{\"amount\":-9007199254740992}",
      "message_pattern": "safe integer range"
    },
    {
      "name": "integral_exponent_above_safe_range",
      "input": "{\"amount\":9007199254740992e0}",
      "message_pattern": "safe integer range"
    },
    {
      "name": "integral_exponent_requires_exact_range_check",
      "input": "{\"amount\":9007199254740993e0}",
      "message_pattern": "safe integer range"
    }
  ],
  "canonicalization_equivalences": [
    {
      "name": "safe_equivalent_exponent_spellings",
      "inputs": [
        "{\"amount\":42e0}",
        "{\"amount\":4.2e1}"
      ],
      "expected": "{\"amount\":42}"
    },
    {
      "name": "historical_rfc8785_nonintegral_rounding",
      "inputs": [
        "{\"amount\":333333333.33333329}",
        "{\"amount\":333333333.3333333}"
      ],
      "expected": "{\"amount\":333333333.3333333}"
    }
  ],
  "expected_signed_document_fields": {
    "_description": "Every signed document must contain these fields (exact values vary)",
    "required_top_level": ["jacsId", "jacsSignature"],
    "required_signature_fields": ["agentID", "date", "signature", "publicKeyHash"]
  },
  "expected_verification_result_fields": {
    "_description": "Every verification result must contain these fields",
    "required": ["valid"],
    "optional": ["signer_id", "timestamp", "errors", "data", "attachments", "identity_bound", "policy_accepted"]
  },
  "response_v2_generic_verification": {
    "_description": "Generic explicit-key verification must auto-dispatch fully bound response-v2 envelopes. Invalid envelopes never release payload or unauthenticated provenance.",
    "algorithm": "ed25519",
    "signature_content_version": "jacs-response-v2",
    "payload": {
      "decision": "allow",
      "context": {
        "request_id": "parity-response-v2"
      }
    },
    "tamper_cases": [
      {
        "name": "payload",
        "pointer": "/data/decision",
        "replacement": "deny"
      },
      {
        "name": "metadata_issuer",
        "pointer": "/metadata/issuer",
        "replacement": "attacker"
      }
    ],
    "invalid_result": {
      "valid": false,
      "data": null,
      "signer_id": "",
      "timestamp": ""
    }
  },
  "sign_message_invalid_json_behavior": {
    "_description": "Documents a known cross-language behavioral difference for sign_message with invalid JSON input. Python's sign_message takes any Python object and serializes it to JSON first (so a raw string becomes a valid JSON string value). Node's signMessage takes a JSON string directly and rejects invalid JSON. Both behaviors are correct for their API contracts.",
    "input": "{{{bad json",
    "rust_binding_core": "rejects (InvalidArgument: serde_json::from_str fails)",
    "python": "succeeds (PyObject -> serde_json::Value serialization wraps string as JSON string value)",
    "node": "rejects (passes raw string to binding-core sign_message_json which expects valid JSON)",
    "go": "rejects (passes raw string to C FFI which calls sign_message_json)"
  },
  "algorithms": ["ed25519", "pq2025"],
  "error_kinds": [
    "AgreementFailed",
    "AgentLoad",
    "DocumentFailed",
    "Generic",
    "InvalidArgument",
    "KeyNotFound",
    "LockFailed",
    "MissingSignature",
    "NetworkFailed",
    "SerializationFailed",
    "SigningFailed",
    "TrustFailed",
    "Validation",
    "VerificationFailed"
  ],
  "portable_error_contract": {
    "message_prefix": "JACS_ERROR_KIND=",
    "removed_algorithm": {
      "input": "pq-dilithium",
      "kind": "AgentLoad"
    }
  }
}
