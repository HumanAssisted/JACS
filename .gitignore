.claude
# Generated by Cargo
# will have compiled files and executables
debug/
target/
.idea
jacs/documents/*
# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
.cursor
.vscode
grant.md
scratch.md
jacs.config.json
!jacs/jacs.config.json
.DS_Store

# Python test/tool caches
**/__pycache__/
*.py[cod]

# JavaScript package-manager installs are reproducible from lockfiles.
**/node_modules/

# Runtime artifacts from tests
var/
documents/
jacsnpm/var/

# Generated files left at the original paths after archiving native packages.
# Anchor these rules to the root so archive/native source stays visible.
/jacs/.jacs_test_archive*/
/jacs/env/
/jacs/tests/scratch/
/jacs/tests/fixtures/**/public_keys/
/jacs/tests/fixtures/*-*-*-*-*:*
/jacs/tests/fixtures/keys/lifecycle-test.*.pem
/jacs/examples/observability/logs/
/jacsgo/build/
/jacsgo/examples/basic/basic
/jacsgo/examples/http/client
/jacsgo/examples/http/server
/jacsgo/examples/mcp/mcp
/jacsnpm/*.node
/jacsnpm/*.tgz
/jacsnpm/agent[123]/
/jacsnpm/shared-data/
/jacspy/build/
/jacspy/dist-prodcheck/
/jacspy/python/**/*.so

# Generated by quickstart/persistent agent tests
**/jacs_data/
**/jacs_keys/

# Local dev overrides — do not commit
.cargo/config.toml

# wasm-pack output — regenerated by `wasm-pack build` and `make build-wasm`.
jacs-wasm/pkg/
