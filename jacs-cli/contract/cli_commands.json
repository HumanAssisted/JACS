{
  "schema_version": 2,
  "cli_name": "jacs",
  "default_algorithm": "pq2025",
  "commands": [
    {"path": "create", "mcp_tool": "jacs_create_agent"},
    {"path": "sign", "mcp_tool": "jacs_sign_document"},
    {"path": "verify", "mcp_tool": "jacs_verify_document"},
    {"path": "rotate", "mcp_tool": "jacs_rotate_keys"},
    {"path": "reencrypt", "mcp_tool": "jacs_reencrypt_key"},
    {"path": "import", "mcp_tool": "jacs_import_encrypted_agent"},
    {"path": "export", "mcp_tool": "jacs_export_encrypted_agent"},
    {"path": "mcp", "mcp_tool": null, "mcp_excluded_reason": "Stdio server startup"}
  ],
  "secret_environment": ["JACS_PRIVATE_KEY_PASSWORD", "JACS_NEW_PRIVATE_KEY_PASSWORD"],
  "stdout": "JSON results, signed JSON, or MCP protocol frames; help/version are human-readable",
  "stderr": "Structured tracing diagnostics and terminal password prompts"
}
